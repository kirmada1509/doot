{
  "name": "doot",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "generate:openapi": "openapi-typescript packages/contracts/openapi/doot.v1.yaml --immutable --output packages/contracts/src/generated/openapi.ts",
    "test:openapi": "node scripts/check-openapi-routes.mjs && openapi-typescript packages/contracts/openapi/doot.v1.yaml --immutable --output packages/contracts/src/generated/openapi.ts --check",
    "test:infra": "docker compose -f infra/compose/docker-compose.yml --profile data --profile workflow --profile observability --profile application config -q",
    "test:postgres": "bash scripts/test-postgres.sh",
    "test:temporal": "bash scripts/test-temporal-integration.sh",
    "smoke": "bash scripts/ci-smoke.sh",
    "test:voice": "bash scripts/test-voice-runtime.sh",
    "test:oidc": "bash scripts/test-oidc.sh",
    "test:calle-rehearsal": "bash scripts/test-calle-rehearsal.sh",
    "test:acceptance": "playwright test",
    "typecheck": "turbo typecheck",
    "dev:console": "pnpm --filter @doot/console dev",
    "dev:api": "pnpm --filter @doot/control-api dev",
    "dev:voice": "bash scripts/dev-voice-runtime.sh",
    "db:migrate": "pnpm --filter @doot/control-api db:migrate",
    "compose:up": "docker compose -f infra/compose/docker-compose.yml --profile data --profile workflow --profile observability up -d"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "openapi-typescript": "^7.9.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
